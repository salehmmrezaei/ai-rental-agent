# Development only. Copy to .env and replace the example password.
POSTGRES_USER=rental
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=rental
DATABASE_URL=postgresql+psycopg://rental:replace-with-a-local-password@localhost:5432/rental
CORS_ORIGINS=["http://localhost:5173"]
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=ai-rental-agent
JWT_AUDIENCE=ai-rental-agent-api
ACCESS_TOKEN_MINUTES=30
AUTH_RATE_LIMIT=20

# Local image storage; Docker uses its persistent /app/uploads volume.
UPLOAD_DIR=backend/uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_PROPERTY_IMAGES=30
