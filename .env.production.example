# Copy to .env.production, chmod 600, and generate independent secrets.
# The production Compose file always enables public demo mode and blanks LLM keys.
CASA_DOMAIN=casa.salehmmrezaei.com
ACME_EMAIL=replace-with-your-email@example.com
CASA_VERSION=local

# Names must contain only letters, digits and underscores; start with a letter.
POSTGRES_USER=casa_bootstrap
POSTGRES_DB=casa_demo
APP_DB_USER=casa_app
# Generate each separately: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Hex passwords also avoid URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-independent-64-character-hex-secret
APP_DB_PASSWORD=replace-with-independent-64-character-hex-secret
JWT_SECRET=replace-with-independent-64-character-hex-secret
# Private seed credential. Never show it in the public UI or distribute it.
DEMO_PASSWORD=replace-with-independent-64-character-hex-secret

PUBLIC_DEMO_MODE=true
DEMO_SESSION_MINUTES=30
DEMO_MAX_SESSIONS=1000
DEMO_ACCESS_RATE_LIMIT=20
DEMO_REQUEST_RATE_LIMIT=240
DEMO_GLOBAL_RATE_LIMIT=1200
ASSISTANT_RATE_LIMIT=10
OPENAI_API_KEY=
ASSISTANT_ENABLED=false
