# Configure privately in the new Casa Vercel project; never use VITE_ for secrets.
# Choose Neon Free explicitly. Runtime URL uses a restricted database role.
DATABASE_URL=postgresql://casa_runtime:REPLACE_PASSWORD@REPLACE_ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-an-independently-generated-64-character-hex-secret
CORS_ORIGINS=["https://casa.salehmmrezaei.com"]
DEMO_MAX_SESSIONS=64
DEMO_SESSION_MINUTES=30
DEMO_ACCESS_RATE_LIMIT=20
DEMO_REQUEST_RATE_LIMIT=240
DEMO_GLOBAL_RATE_LIMIT=1200
ASSISTANT_RATE_LIMIT=10
# These values are enforced again by backend/vercel_entry.py.
PUBLIC_DEMO_MODE=true
DEMO_STATE_BACKEND=postgres
SERVERLESS_DATABASE=true
PUBLIC_DOCS_ENABLED=false
OPENAI_API_KEY=
ASSISTANT_ENABLED=false
# Do NOT add the owner/direct URL or seed password to Vercel.
# Operator shell only: DATABASE_DIRECT_URL=postgresql://OWNER:...@DIRECT_HOST/neondb?sslmode=require
